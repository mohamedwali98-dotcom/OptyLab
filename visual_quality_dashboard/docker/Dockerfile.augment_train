# Dockerfile for augment_and_train.py pipeline
# Build and run the data augmentation and model training pipeline
# 
# Usage:
#   # Build
#   docker build -t optylab/augment_train -f docker/Dockerfile.augment_train .
#   
#   # Run (with data volumes)
#   docker run --rm \
#     -e AUG_PER_IMAGE=10 \
#     -v "$(pwd)/DB:/app/DB" \
#     -v "$(pwd)/backend/model:/app/model" \
#     optylab/augment_train
#
# Or use the shortcut:
#   ./docker/augment_train.sh

FROM python:3.11-slim

# System dependencies for OpenCV/skimage and image processing
RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements and install Python dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Create necessary directories
# DB folder will be mounted from host or created in container
RUN mkdir -p /app/DB/RawImagesDamaged /app/DB/RawImagesGood \
    /app/DB/Damaged /app/DB/Good /app/model /app/backups

# Copy backend application code
COPY backend/augment_and_train.py .
COPY backend/augmentations.py .
COPY backend/classifier.py .
COPY backend/classifier_utils.py .
COPY backend/classifier_svm.py .
COPY backend/classifier_cnn.py .
COPY backend/classifier_vit.py .
COPY backend/gradcam.py .

# Environment variables
ENV PYTHONUNBUFFERED=1
ENV AUG_PER_IMAGE=10

# Create symlink from /DB to /app/DB (the code expects /DB)
RUN ln -sf /app/DB /DB

# Run the training pipeline
CMD ["python", "augment_and_train.py"]