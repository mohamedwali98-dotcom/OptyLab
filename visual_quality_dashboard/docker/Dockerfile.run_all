# Dockerfile for run_all.py orchestration (Full stack)
# Build and run both frontend and backend together
#
# Usage:
#   # Build
#   docker build -t optylab/run_all -f visual_quality_dashboard/docker/Dockerfile.run_all .
#   
#   # Run in foreground
#   docker run -p 8080:80 -p 8000:8000 -v $(pwd)/DB:/app/DB optylab/run_all
#   
#   # Run in detached mode
#   docker run -d --name optylab_run_all -p 8080:80 -p 8000:8000 -v $(pwd)/DB:/app/DB optylab/run_all
#
# Or use the shortcut:
#   ./visual_quality_dashboard/docker/run_all.sh

# ── Build stage: Frontend ─────────────────────────────────────────────────────
FROM node:20-alpine AS build-frontend
WORKDIR /app

# Copy package files and install dependencies
COPY package*.json ./
RUN npm install

# Copy frontend source files
COPY src ./src
COPY public ./public
COPY index.html .
COPY vite.config.js .
COPY tailwind.config.js .
COPY postcss.config.js .
COPY .oxlintrc.json ./

ARG VITE_API_URL=http://localhost:8000
ENV VITE_API_URL=$VITE_API_URL

# Build the production frontend
RUN npm run build

# ── Production stage: Backend + Nginx ────────────────────────────────────────
FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    libgl1 \
    libglib2.0-0 \
    nginx \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy backend directory first (for requirements.txt)
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend application code
COPY backend/ .

# Copy built frontend from build stage
COPY --from=build-frontend /app/dist /usr/share/nginx/html/

# Copy nginx config
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Create symlink from /DB to /app/DB (code expects /DB)
RUN mkdir -p /app/DB/RawImagesDamaged /app/DB/RawImagesGood \
    /app/DB/Damaged /app/DB/Good /app/model /app/uploads /app/heatmaps /app/backups && \
    ln -sf /app/DB /DB

# Expose ports (80 for frontend, 8000 for backend API)
EXPOSE 80 8000

# Start both nginx and uvicorn
CMD ["/bin/bash", "-c", "nginx -g 'daemon off;' & uvicorn main:app --host 0.0.0.0 --port 8000"]